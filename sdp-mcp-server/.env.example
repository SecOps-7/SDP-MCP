# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVER_ENDPOINTS=localhost
SERVER_HOST=localhost # Hostname used in client connection strings (set to server IP/hostname for remote access)

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sdp_mcp
DB_USER=sdpmcpservice
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false
REDIS_DB=0

# Service Desk Plus Configuration
SDP_API_VERSION=v3
SDP_DEFAULT_PAGE_SIZE=100
SDP_MAX_PAGE_SIZE=500
SDP_TIMEOUT_MS=30000
SDP_RETRY_ATTEMPTS=3
SDP_RETRY_DELAY_MS=1000

# Service Desk Plus OAuth Configuration
# Variable names must match exactly — the server reads these specific keys.
SDP_BASE_URL=https://your-domain.com          # Custom domain URL (e.g. https://helpdesk.example.com)
SDP_INSTANCE_NAME=your-instance-name          # SDP instance name (segment after /app/ in the URL)
SDP_PORTAL_NAME=your-portal-name              # Zoho portal/org name (used when no custom domain)
SDP_DATA_CENTER=US                            # Options: US, EU, IN, AU, JP, UK, CA, CN
SDP_CLIENT_ID=your-client-id                  # OAuth self-client Client ID
SDP_CLIENT_SECRET=your-client-secret          # OAuth self-client Client Secret
SDP_REFRESH_TOKEN=your-permanent-refresh-token # Permanent refresh token from OAuth setup

# Simple SSE Server Configuration
SDP_HTTP_PORT=3456 # Port for SSE server
SDP_HTTP_HOST=0.0.0.0 # Host to bind to

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PER_TENANT=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/sdp-mcp.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
LOG_COMPRESS=true

# Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_MS=30000
ENABLE_TRACING=true
TRACING_ENDPOINT=http://localhost:4318

# Multi-Tenant Configuration
MAX_TENANTS=100
TENANT_CACHE_TTL_SECONDS=300
TOKEN_REFRESH_BUFFER_SECONDS=300
SCOPE_VALIDATION_ENABLED=true

# Admin Interface
ADMIN_API_ENABLED=true
ADMIN_API_KEY=your-admin-api-key-here
ADMIN_PORT=3001

# Development Settings
DEBUG=false
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true

# pgAdmin (development only)
PGADMIN_EMAIL=admin@sdpmcp.local
PGADMIN_PASSWORD=admin