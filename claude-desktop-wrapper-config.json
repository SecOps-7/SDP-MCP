{
  "mcpServers": {
    "service-desk-plus": {
      "command": "node",
      "args": [
        "/path/to/remote-stdio-wrapper.js"
      ],
      "env": {
        "REMOTE_HOST": "192.168.2.10",
        "REMOTE_PORT": "3456",
        "SDP_CLIENT_ID": "YOUR_CLIENT_ID",
        "SDP_CLIENT_SECRET": "YOUR_CLIENT_SECRET"
      }
    }
  }
}